# Copy outside Git as .env. Do not commit real secret values.
EXTERNAL_TRANSPORT_TOKEN=replace-with-a-long-random-token
# fake is safe for protocol testing. Set openai_realtime only with OPENAI_API_KEY.
REALTIME_PROVIDER=fake
OPENAI_REALTIME_MODEL=gpt-realtime-mini
# OPENAI_API_KEY=...
MAX_CONCURRENT_SESSIONS=2
MAX_AUDIO_FRAME_BYTES=32000
MAX_INPUT_BYTES=9600000
MAX_BUFFERED_AUDIO_FRAMES=64
