# Copy outside Git as .env. Do not commit real secret values.
EXTERNAL_TRANSPORT_TOKEN=replace-with-a-long-random-token
# fake is safe for protocol testing. Set openai_realtime only with OPENAI_API_KEY.
REALTIME_PROVIDER=fake
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin
# OPENAI_API_KEY=...
# Required with REALTIME_PROVIDER=openai_realtime; public URL must resolve from tablets.
# PUBLIC_BASE_URL=https://voice-agent.example
# AUDIO_URL_SIGNING_KEY=replace-with-a-separate-long-random-secret
MAX_CONCURRENT_SESSIONS=2
MAX_AUDIO_FRAME_BYTES=32000
MAX_INPUT_BYTES=9600000
MAX_BUFFERED_AUDIO_FRAMES=64
# Assistant output is discarded rather than blocking the provider if no client opens it.
MAX_BUFFERED_OUTPUT_CHUNKS=64
AUDIO_STREAM_WRITE_TIMEOUT_SECONDS=1
AUDIO_URL_TOKEN_TTL_SECONDS=60
# Optional read-only mounted JSON file declaring fixed MCP/script tools.
# TRUSTED_TOOL_CONFIG_PATH=/run/config/voice-tools.json
